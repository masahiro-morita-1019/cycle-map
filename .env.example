# 公共交通オープンデータセンター (ODPT) アクセストークン
# https://developer.odpt.org/ で無料登録して取得
ODPT_CONSUMER_KEY=

# Upstash Redis
# Vercel Marketplace の Upstash for Redis を Install すると、後方互換のため
# 以下の KV_* 変数が自動注入される。ローカルでは Vercel ダッシュボードから値をコピペ。
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 以下は使わないが、Vercel 注入時に併せて来るので参考として記載
# KV_REST_API_READ_ONLY_TOKEN=
# KV_URL=
# REDIS_URL=

# Upstash と直接契約する場合は、上記の代わりにこちらをセットしても良い
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Postgres (Neon)
DATABASE_URL=

# Vercel Cron 認証 (本番では必須。任意の長いランダム文字列)
CRON_SECRET=

# 動的データの保持期間と「古い」と判定する秒数
# 日次 Cron の既定構成では48時間保持し、15分を超えたデータは地図上で古いと表示する
# 数分間隔の外部 Cron を使う場合は STATUS_TTL_SECONDS を900〜1800程度に短縮可能
STATUS_TTL_SECONDS=172800
STATUS_STALE_AFTER_SECONDS=900

# Protomaps タイル API キー (https://protomaps.com/)
NEXT_PUBLIC_PROTOMAPS_API_KEY=
