# 公共交通オープンデータセンター (ODPT) アクセストークン
# https://developer.odpt.org/ で無料登録して取得
ODPT_CONSUMER_KEY=

# Upstash Redis (Vercel Marketplace の Upstash 統合で自動注入される)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Postgres (Neon)
DATABASE_URL=

# Vercel Cron 認証 (任意の長いランダム文字列)
CRON_SECRET=

# Protomaps タイル API キー (https://protomaps.com/)
NEXT_PUBLIC_PROTOMAPS_API_KEY=
